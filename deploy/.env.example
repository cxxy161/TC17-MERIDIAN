# ---------- 监听 ----------
# 容器内固定监听 0.0.0.0:18420（否则 Docker 端口转发无法触达；宿主机暴露范围由 docker-compose ports 控制）
MERIDIAN_ADDR=0.0.0.0:18420
MERIDIAN_TICK_MS=1000
# 玩家脚本单 tick 纯执行墙钟上限（毫秒，默认 10；范围 1..500）
# MERIDIAN_JS_CPU_LIMIT_MS=10

# ---------- 初始管理员（可选）----------
# 不要提交弱口令。可用 openssl rand -base64 24 生成，或干脆不配置、
# 直接走 /api/auth/register 注册首个账号（首个注册者会成为 admin）。
# MERIDIAN_ADMIN_EMAIL=admin@example.com
# MERIDIAN_ADMIN_PASSWORD=
# MERIDIAN_ADMIN_NICKNAME=Admin

# ---------- 反向代理信任 ----------
# 仅当直连 peer 属于这些 CIDR 时才采信 X-Forwarded-For（取最右一跳）。
# 直连部署留空；Caddy/nginx 与后端同机时填 127.0.0.1/32,::1/128。
MERIDIAN_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# ---------- CORS ----------
# 逗号分隔的完整 Origin（scheme://host[:port]）。为空 = 不启用跨域（同源部署正确）。
# 例：MERIDIAN_ALLOWED_ORIGINS=https://meridian.example.com
MERIDIAN_ALLOWED_ORIGINS=

# ---------- 人机验证（可选）----------
# 配置 Secret + Site Key 后注册强制校验 Turnstile（Site Key 由 /api/auth/config 运行时下发）；
# 未配置 Secret 则跳过（本地开发）。
# MERIDIAN_TURNSTILE_SITE_KEY=
# MERIDIAN_TURNSTILE_SECRET=
# 内网/Tailscale 直连跳过 Turnstile 的白名单（可选）：
# 两者都填时需 TCP peer 与 Host 同时命中且不带代理头才跳过，防止公网伪造 Host 绕过。
# MERIDIAN_TURNSTILE_SKIP_PEERS=100.64.0.0/10,127.0.0.1/32,::1/128
# MERIDIAN_TURNSTILE_SKIP_HOSTS=

# ---------- Cookie Secure ----------
# 未设置时按每个请求的 X-Forwarded-Proto 自动判断；1=总是 Secure，0=从不。
# TLS 反代后建议显式 1。
# MERIDIAN_COOKIE_SECURE=1
